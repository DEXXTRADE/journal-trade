rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isMainJournal(journalId) {
      return journalId == 'main';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateKey(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function parentJournalExists(journalId) {
      return existsAfter(/databases/$(database)/documents/journals/$(journalId));
    }

    function isValidJournalSettings(data, journalId) {
      return data.keys().hasAll(['journalId', 'journalName', 'initialCapitalIdr', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['journalId', 'journalName', 'initialCapitalIdr', 'theme', 'createdAt', 'updatedAt'])
        && data.journalId is string
        && data.journalId == journalId
        && data.journalName is string
        && data.journalName.size() >= 1
        && data.journalName.size() <= 40
        && (data.initialCapitalIdr is int || data.initialCapitalIdr is float)
        && data.initialCapitalIdr > 0
        && data.initialCapitalIdr <= 1000000000000
        && data.theme is string
        && data.theme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTradeEntry(data, journalId) {
      return data.keys().hasAll([
          'journalId',
          'dateKey',
          'session',
          'dateLabel',
          'pair',
          'position',
          'method',
          'riskPercent',
          'outcome',
          'pnlIdr',
          'note',
          'clientCreatedAt',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'journalId',
          'dateKey',
          'session',
          'dateLabel',
          'pair',
          'position',
          'method',
          'riskPercent',
          'outcome',
          'pnlIdr',
          'note',
          'clientCreatedAt',
          'createdAt'
        ])
        && data.journalId is string
        && data.journalId == journalId
        && isValidDateKey(data.dateKey)
        && data.session is string
        && data.session in ['Asia', 'London', 'New York']
        && data.dateLabel is string
        && data.dateLabel.size() >= 1
        && data.dateLabel.size() <= 30
        && data.pair is string
        && data.pair.size() >= 1
        && data.pair.size() <= 20
        && data.position is string
        && data.position in ['Buy', 'Sell']
        && data.method is string
        && data.method.size() >= 1
        && data.method.size() <= 80
        && (data.riskPercent is int || data.riskPercent is float)
        && data.riskPercent > 0
        && data.riskPercent <= 100
        && data.outcome is string
        && data.outcome in ['Win', 'Loss', 'BE']
        && (data.pnlIdr is int || data.pnlIdr is float)
        && data.pnlIdr >= -1000000000000
        && data.pnlIdr <= 1000000000000
        && data.note is string
        && data.note.size() <= 500
        && data.clientCreatedAt is string
        && data.clientCreatedAt.size() >= 1
        && data.clientCreatedAt.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidCashflowEntry(data, journalId) {
      return data.keys().hasAll([
          'journalId',
          'dateKey',
          'dateLabel',
          'type',
          'amountIdr',
          'note',
          'clientCreatedAt',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'journalId',
          'dateKey',
          'dateLabel',
          'type',
          'amountIdr',
          'note',
          'clientCreatedAt',
          'createdAt'
        ])
        && data.journalId is string
        && data.journalId == journalId
        && isValidDateKey(data.dateKey)
        && data.dateLabel is string
        && data.dateLabel.size() >= 1
        && data.dateLabel.size() <= 30
        && data.type is string
        && data.type in ['deposit', 'withdraw']
        && (data.amountIdr is int || data.amountIdr is float)
        && data.amountIdr > 0
        && data.amountIdr <= 1000000000000
        && data.note is string
        && data.note.size() <= 300
        && data.clientCreatedAt is string
        && data.clientCreatedAt.size() >= 1
        && data.clientCreatedAt.size() <= 40
        && data.createdAt is timestamp;
    }

    match /journals/{journalId} {
      allow get: if isMainJournal(journalId) && isValidId(journalId);
      allow list: if false;
      allow create: if isMainJournal(journalId) && isValidId(journalId)
        && isValidJournalSettings(incoming(), journalId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isMainJournal(journalId) && isValidId(journalId)
        && isValidJournalSettings(incoming(), journalId)
        && incoming().journalId == existing().journalId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['journalName', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['initialCapitalIdr', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['journalName', 'initialCapitalIdr', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['journalName', 'initialCapitalIdr', 'theme', 'updatedAt'])
        );
      allow delete: if false;

      match /trades/{tradeId} {
        allow get: if isMainJournal(journalId) && isValidId(journalId) && isValidId(tradeId);
        allow list: if isMainJournal(journalId) && existing().journalId == journalId;
        allow create: if isMainJournal(journalId) && isValidId(journalId) && isValidId(tradeId)
          && isValidTradeEntry(incoming(), journalId)
          && incoming().createdAt == request.time
          && parentJournalExists(journalId);
        allow update: if false;
        allow delete: if isMainJournal(journalId) && isValidId(journalId) && isValidId(tradeId)
          && existing().journalId == journalId;
      }

      match /cashflows/{cashflowId} {
        allow get: if isMainJournal(journalId) && isValidId(journalId) && isValidId(cashflowId);
        allow list: if isMainJournal(journalId) && existing().journalId == journalId;
        allow create: if isMainJournal(journalId) && isValidId(journalId) && isValidId(cashflowId)
          && isValidCashflowEntry(incoming(), journalId)
          && incoming().createdAt == request.time
          && parentJournalExists(journalId);
        allow update: if false;
        allow delete: if isMainJournal(journalId) && isValidId(journalId) && isValidId(cashflowId)
          && existing().journalId == journalId;
      }
    }
  }
}
